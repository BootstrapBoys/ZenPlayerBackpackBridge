<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ZenPlayerBackpackBridge</AssemblyName>
    <RootNamespace>ZenPlayerBackpackBridge</RootNamespace>
    <Version>1.1.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- CI Detection: GitHub Actions sets 'CI' environment variable to 'true' -->
  <PropertyGroup Condition="'$(CI)' == 'true'">
    <GameLibsDir>$(MSBuildProjectDirectory)\libs</GameLibsDir>
  </PropertyGroup>

  <!-- Local PC Paths (Used when building on your personal machine) -->
  <PropertyGroup Condition="'$(CI)' != 'true'">
    <ValheimManagedDir>C:\SteamLibrary\steamapps\common\Valheim\valheim_Data\Managed</ValheimManagedDir>
    <BepInExCoreDir>C:\Users\zebz2\AppData\Roaming\com.kesomannen.gale\valheim\profiles\Bootstrap Boys Private Server Pack\BepInEx\core</BepInExCoreDir>
    <BepInExPluginsDir>C:\Users\zebz2\AppData\Roaming\com.kesomannen.gale\valheim\profiles\Bootstrap Boys Private Server Pack\BepInEx\plugins</BepInExPluginsDir>
    <GameLibsDir>$(MSBuildProjectDirectory)\libs</GameLibsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core Valheim References (Checks local paths first, falls back to ./libs if CI) -->
    <Reference Include="UnityEngine">
      <HintPath Condition="'$(CI)' != 'true'">$(ValheimManagedDir)\UnityEngine.dll</HintPath>
      <HintPath Condition="'$(CI)' == 'true'">$(GameLibsDir)\UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath Condition="'$(CI)' != 'true'">$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <HintPath Condition="'$(CI)' == 'true'">$(GameLibsDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath Condition="'$(CI)' != 'true'">$(ValheimManagedDir)\assembly_valheim.dll</HintPath>
      <HintPath Condition="'$(CI)' == 'true'">$(GameLibsDir)\assembly_valheim.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- BepInEx & Harmony References -->
    <Reference Include="BepInEx">
      <HintPath Condition="'$(CI)' != 'true'">$(BepInExCoreDir)\BepInEx.dll</HintPath>
      <HintPath Condition="'$(CI)' == 'true'">$(GameLibsDir)\BepInEx.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath Condition="'$(CI)' != 'true'">$(BepInExCoreDir)\0Harmony.dll</HintPath>
      <HintPath Condition="'$(CI)' == 'true'">$(GameLibsDir)\0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>

    <!-- Mod References (Adventure Backpacks & ZenPlayer) -->
    <Reference Include="AdventureBackpacks">
      <HintPath Condition="'$(CI)' != 'true'">$(BepInExPluginsDir)\Vapok-AdventureBackpacks\AdventureBackpacks.dll</HintPath>
      <HintPath Condition="'$(CI)' == 'true'">$(GameLibsDir)\AdventureBackpacks.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ZenPlayer">
      <HintPath Condition="'$(CI)' != 'true'">$(BepInExPluginsDir)\ZenDragon-ZenPlayer\ZenPlayer.dll</HintPath>
      <HintPath Condition="'$(CI)' == 'true'">$(GameLibsDir)\ZenPlayer.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

</Project>
