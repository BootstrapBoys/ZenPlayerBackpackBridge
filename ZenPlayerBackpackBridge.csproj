<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>ZenPlayerBackpackBridge</AssemblyName>
    <RootNamespace>ZenPlayerBackpackBridge</RootNamespace>
    <Description>Lets ZenPlayer's "Have In Inventory" auto-pickup count items stored in your equipped AdventureBackpack.</Description>

    <!-- Keep in sync with Plugin.ModVersion, resources/manifest.json and the top
         resources/CHANGELOG.md heading. tooling/build-check/Inspect fails the build if they drift. -->
    <Version>1.3.4</Version>
    <AssemblyVersion>1.3.4.0</AssemblyVersion>
    <FileVersion>1.3.4.0</FileVersion>

    <LangVersion>latest</LangVersion>

    <!-- Override these without editing this file:
         VALHEIM_DIR  directory that contains valheim_Data/Managed
         BEPINEX_DIR  directory that contains core/BepInEx.dll
         MODS_DIR     directory that contains AdventureBackpacks.dll -->
    <ValheimInstallDir Condition="'$(VALHEIM_DIR)' != ''">$(VALHEIM_DIR)</ValheimInstallDir>
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">C:\SteamLibrary\steamapps\common\Valheim</ValheimInstallDir>

    <BepInExDir Condition="'$(BEPINEX_DIR)' != ''">$(BEPINEX_DIR)</BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">C:\Users\zebz2\AppData\Roaming\com.kesomannen.gale\valheim\profiles\Bootstrap Boys Private Server Pack\BepInEx</BepInExDir>

    <ModsDir Condition="'$(MODS_DIR)' != ''">$(MODS_DIR)</ModsDir>
    <ModsDir Condition="'$(ModsDir)' == ''">$(BepInExDir)/plugins/Vapok-AdventureBackpacks</ModsDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- tooling/ contains the audit project; docs/ is reserved for decompiled reference sources.
         Either would otherwise be swallowed by the SDK's default **/*.cs glob. -->
    <Compile Remove="tooling/**/*.cs" />
    <Compile Remove="docs/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- BepInEx + Harmony -->
    <Reference Include="BepInEx">
      <HintPath>$(BepInExDir)/core/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExDir)/core/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Valheim + Unity -->
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimInstallDir)/valheim_Data/Managed/assembly_valheim.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- AdventureBackpacks is called through its public ABAPI surface, so it is a real compile
         reference. ZenPlayer is reached only by GUID + reflection and deliberately is not one. -->
    <Reference Include="AdventureBackpacks">
      <HintPath>$(ModsDir)/AdventureBackpacks.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
